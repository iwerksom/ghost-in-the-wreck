# dependencies & build output
node_modules/
dist/
artifact.html
ghost-in-the-wreck.html
*.zip

# Training artifacts. Three things from the shipping run ARE committed, because
# they cost 2.5 h of CPU and cannot be reproduced bit-for-bit:
#   game/weights.js       the shipped int8 model
#   model/ckpt/best.pt    the PyTorch checkpoint behind it (11 MB)
#   model/train.log       the loss curve; gate-train greps it for VAL
# Everything below is derived and regenerates deterministically, so it stays out:
# dataset.npz rebuilds from corpus/raw in seconds, and the periodic checkpoints
# are 11 MB each.
model/ckpt/*
!model/ckpt/best.pt
corpus/build/dataset.npz
nohup.out

# test output
test/shots/
*.pdf
docs/slide-*.jpg
docs/thumbnails*.jpg

# factory run state for this project (see wreck-works)
.factory/

# godot editor cache
godot/.godot/

# python
__pycache__/
*.pyc
.venv/
